{
  "manifest_version": 3,
  "name": "WhatsApp Bulk Auto-Sender",
  "version": "1.0",
  "description": "Automatically clicks the Send button on WhatsApp Web for bulk messaging",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
